# Public canonical origin used for metadata, robots, and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional future backend adapter. Do not put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_API_BASE_URL=

# Optional public analytics property identifier.
NEXT_PUBLIC_ANALYTICS_ID=

# Server-only authentication and API secrets belong in the hosting
# environment and must never be prefixed with NEXT_PUBLIC_.
AUTH_SECRET=
